{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sythoria",
  "version": "0.4.4",
  "identifier": "com.sythoria.sythoria-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Sythoria",
        "width": 1200,
        "height": 780,
        "minWidth": 420,
        "minHeight": 560,
        "transparent": true,
        "decorations": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "center": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 30
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhBMEU2MzU4OEU0ODBGNTMKUldSVEQwaU9XR01PaXNCbSt2WVFMbU9uR2IzVHdueU12bU1KOGIvTWFrNFUrMm00ODJ3TTNORVgK",
      "endpoints": [
        "https://github.com/sythoria/sythoria-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
